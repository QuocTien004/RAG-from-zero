# ===== Mẫu cấu hình môi trường =====
# Cách dùng: sao chép file này thành .env rồi điền giá trị thật.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS/Linux:           cp .env.example .env
#
# Lấy API key miễn phí tại Google AI Studio: https://aistudio.google.com/apikey
# LƯU Ý: KHÔNG commit file .env thật lên git (đã được .gitignore chặn).

# ----- Gemini: CHỈ dùng để chat (sinh câu trả lời) -----
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest

# ----- Embedding: MIỄN PHÍ, chạy cục bộ (không cần API key) -----
# Tên model sentence-transformers. Lần đầu chạy sẽ tự tải model về (~470MB) rồi cache.
# Có thể đổi sang model khác, ví dụ: intfloat/multilingual-e5-base (nặng hơn, tốt hơn).
EMBED_MODEL=intfloat/multilingual-e5-small

# ----- (Tuỳ chọn) Tinh chỉnh tham số RAG -----
RAG_CHUNK_SIZE=800       # Số ký tự mỗi đoạn (chunk)
RAG_CHUNK_OVERLAP=120    # Số ký tự chồng lấn giữa 2 đoạn liền kề
RAG_TOP_K=4              # Số đoạn liên quan nhất lấy ra để trả lời
